{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licensing.zithis.example/protocol/v1/deactivate-request.schema.json",
  "title": "deactivate request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "client",
    "product",
    "installation",
    "operation",
    "credential"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "client": {
      "$ref": "common.schema.json#/$defs/client"
    },
    "product": {
      "$ref": "common.schema.json#/$defs/product"
    },
    "installation": {
      "$ref": "common.schema.json#/$defs/installation"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "name": {
          "const": "deactivate"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "credential": {
      "$ref": "common.schema.json#/$defs/credential"
    }
  }
}
