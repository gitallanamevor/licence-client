{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licensing.zithis.example/protocol/v1/activate-request.schema.json",
  "title": "activate request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "client",
    "product",
    "installation",
    "operation"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "client": {
      "$ref": "common.schema.json#/$defs/client"
    },
    "product": {
      "$ref": "common.schema.json#/$defs/product"
    },
    "installation": {
      "$ref": "common.schema.json#/$defs/installation"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "name": {
          "const": "activate"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "licence_key"
          ],
          "properties": {
            "licence_key": {
              "type": "string",
              "minLength": 8,
              "maxLength": 255
            }
          }
        }
      }
    }
  }
}
