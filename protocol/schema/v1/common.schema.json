{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licensing.zithis.example/protocol/v1/common.schema.json",
  "title": "Zithis product-neutral licence protocol v1 common definitions",
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "timestamp",
        "nonce"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32}$"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "supported_protocol_versions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "supported_protocol_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "package_identifier",
        "installed_version"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "package_identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "installed_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "responseProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "package_identifier"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "package_identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "environment",
        "canonical_uri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "environment": {
          "enum": [
            "production",
            "staging",
            "development",
            "local"
          ]
        },
        "canonical_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "responseInstallation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "environment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "environment": {
          "enum": [
            "production",
            "staging",
            "development",
            "local"
          ]
        }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "activation_secret"
      ],
      "properties": {
        "activation_id": {
          "type": "string",
          "format": "uuid"
        },
        "activation_secret": {
          "type": "string",
          "pattern": "^[0-9A-Za-z_-]{43,128}$"
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "entitlements",
        "term_started_at",
        "expires_at",
        "validation_due_at",
        "grace_expires_at",
        "activation_limits",
        "activation_usage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "active",
            "validation_due",
            "grace",
            "expired",
            "suspended",
            "revoked",
            "deactivated"
          ]
        },
        "entitlements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,63}$"
          }
        },
        "term_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "validation_due_at": {
          "type": "string",
          "format": "date-time"
        },
        "grace_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "activation_limits": {
          "$ref": "#/$defs/activationCounts"
        },
        "activation_usage": {
          "$ref": "#/$defs/activationCounts"
        }
      }
    },
    "activationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production",
        "non_production"
      ],
      "properties": {
        "production": {
          "type": "integer",
          "minimum": 0
        },
        "non_production": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "algorithm": {
          "const": "RS256"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "signedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "signed_payload",
        "signature"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "signed_payload": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "error"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "category",
            "retryable",
            "request_id"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,63}$"
            },
            "category": {
              "enum": [
                "transport",
                "protocol",
                "compatibility",
                "authority",
                "credential",
                "local_state",
                "server"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
